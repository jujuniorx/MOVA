DATABASE_URL=""
JWT_SECRET=""
FRONTEND_URL="http://localhost:5173"

# Mercado Pago — nunca preencher com credenciais reais neste arquivo.
# MP_ACCESS_TOKEN: token privado da conta Mercado Pago (Credenciais > Access Token).
#   Use o token de TESTE durante o desenvolvimento; nunca o de produção fora do ambiente real.
# MP_WEBHOOK_SECRET: "Assinatura secreta" configurada em Mercado Pago > Webhooks
#   para a URL deste backend (/webhooks/mercado-pago) — usada para validar
#   que a notificação realmente veio do Mercado Pago.
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""

# Criptografia de credenciais de terceiros em repouso (tokens do Mercado
# Livre, etc.) — NUNCA usado para senha de usuário (essa continua bcrypt).
# Precisa decodificar (base64) para exatamente 32 bytes (AES-256). Gerar com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=""

# Mercado Livre — OAuth 2.0 (developers.mercadolivre.com.br). Criar uma
# aplicação no painel de desenvolvedores para obter client_id/client_secret;
# o redirect_uri deve ser exatamente igual ao cadastrado na aplicação e
# apontar para GET /integracoes/mercado-livre/callback deste backend.
MERCADO_LIVRE_CLIENT_ID=""
MERCADO_LIVRE_CLIENT_SECRET=""
MERCADO_LIVRE_REDIRECT_URI="http://localhost:3000/integracoes/mercado-livre/callback"

# WhatsApp Business Cloud API (Meta for Developers).
# WHATSAPP_VERIFY_TOKEN: valor arbitrário definido por você, usado só para
#   confirmar a assinatura do webhook (GET /webhooks/whatsapp) na Meta.
# WHATSAPP_APP_SECRET: "App Secret" do app na Meta — usado para validar a
#   assinatura HMAC (X-Hub-Signature-256) de todo webhook recebido (POST
#   /webhooks/whatsapp). Sem isso definido, o webhook rejeita toda
#   requisição (não há como confirmar que veio da Meta de verdade).
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# IA — dois provedores suportados atrás da mesma interface (backend/src/lib/ia.ts).
# IA_PROVIDER escolhe qual um é usado pelas capacidades de TEXTO hoje.
# Padrão "anthropic" (o que já está em produção) — só muda com IA_PROVIDER=openai
# explícito. Sem a chave do provedor ativo, os recursos de IA respondem 503
# "não configurado" — nunca simulam uma resposta.
IA_PROVIDER="anthropic"

# Provedor "anthropic" (Anthropic Messages API).
IA_API_KEY=""
IA_MODEL_SIMPLES="claude-haiku-4-5-20251001"
IA_MODEL_COMPLEXO="claude-sonnet-5"

# Provedor "openai" (Chat Completions API) — usada para texto só quando
# IA_PROVIDER=openai. gpt-4o-mini/gpt-4o são o padrão: bom custo-benefício
# para as capacidades "simples" (resumos, listas curtas) e "complexas"
# (redação livre, estruturação de catálogo), respectivamente.
OPENAI_API_KEY=""
IA_MODEL_SIMPLES_OPENAI="gpt-4o-mini"
IA_MODEL_COMPLEXO_OPENAI="gpt-4o"

# Transcrição de áudio para o cadastro de catálogo por voz (Whisper, sempre
# OpenAI, independente de IA_PROVIDER). Usa TRANSCRICAO_API_KEY se definida,
# senão cai para OPENAI_API_KEY acima — sem nenhuma das duas, o cadastro por
# áudio responde 503 "não configurado", nunca finge transcrever.
TRANSCRICAO_API_KEY=""

# Criação/atualização do administrador local (rodar `npm run admin:criar`).
# Usadas SÓ nesse momento — depois de criar o admin, pode apagar ADMIN_SENHA
# daqui. Nunca preencher com um valor real neste arquivo (.env.example é
# versionado); a senha de verdade só existe no seu .env local, que está no
# .gitignore.
ADMIN_EMAIL=""
ADMIN_SENHA=""
ADMIN_NOME="Junior Dev"
